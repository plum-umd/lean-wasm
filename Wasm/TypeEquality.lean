  def storageEq : (a b : StorageType) → Decidable (a = b)
    | .val a0, .val b0 => by
      letI : Decidable (a0 = b0) := valEq a0 b0
      exact decidable_of_iff (a0 = b0) (by simp)
    | .val a0, .i8 => isFalse (by intro h; cases h)
    | .val a0, .i16 => isFalse (by intro h; cases h)
    | .i8, .val b0 => isFalse (by intro h; cases h)
    | .i8, .i8 => isTrue rfl
    | .i8, .i16 => isFalse (by intro h; cases h)
    | .i16, .val b0 => isFalse (by intro h; cases h)
    | .i16, .i8 => isFalse (by intro h; cases h)
    | .i16, .i16 => isTrue rfl
  def fieldEq : (a b : FieldType) → Decidable (a = b)
    | .mk a0 a1, .mk b0 b1 => by
      letI : Decidable (a0 = b0) := storageEq a0 b0
      exact decidable_of_iff (a0 = b0 ∧ a1 = b1) (by simp)
  def subEq : (a b : SubType) → Decidable (a = b)
    | .func a0 a1 a2 a3, .func b0 b1 b2 b3 => by
      letI : Decidable (a1 = b1) := heapListEq a1 b1
      letI : Decidable (a2 = b2) := valListEq a2 b2
      letI : Decidable (a3 = b3) := valListEq a3 b3
      exact decidable_of_iff (a0 = b0 ∧ a1 = b1 ∧ a2 = b2 ∧ a3 = b3) (by simp)
    | .func a0 a1 a2 a3, .struct_ b0 b1 b2 => isFalse (by intro h; cases h)
    | .func a0 a1 a2 a3, .array b0 b1 b2 => isFalse (by intro h; cases h)
    | .struct_ a0 a1 a2, .func b0 b1 b2 b3 => isFalse (by intro h; cases h)
    | .struct_ a0 a1 a2, .struct_ b0 b1 b2 => by
      letI : Decidable (a1 = b1) := heapListEq a1 b1
      letI : Decidable (a2 = b2) := fieldListEq a2 b2
      exact decidable_of_iff (a0 = b0 ∧ a1 = b1 ∧ a2 = b2) (by simp)
    | .struct_ a0 a1 a2, .array b0 b1 b2 => isFalse (by intro h; cases h)
    | .array a0 a1 a2, .func b0 b1 b2 b3 => isFalse (by intro h; cases h)
    | .array a0 a1 a2, .struct_ b0 b1 b2 => isFalse (by intro h; cases h)
    | .array a0 a1 a2, .array b0 b1 b2 => by
      letI : Decidable (a1 = b1) := heapListEq a1 b1
      letI : Decidable (a2 = b2) := fieldEq a2 b2
      exact decidable_of_iff (a0 = b0 ∧ a1 = b1 ∧ a2 = b2) (by simp)
  def subListEq : (a b : List SubType) → Decidable (a = b)
    | [], [] => isTrue rfl
    | [], _ :: _ => isFalse (by intro h; cases h)
    | _ :: _, [] => isFalse (by intro h; cases h)
    | a :: as, b :: bs => by
      letI : Decidable (a = b) := subEq a b
      letI : Decidable (as = bs) := subListEq as bs
      exact decidable_of_iff (a = b ∧ as = bs) (by simp)
  def heapListEq : (a b : List HeapType) → Decidable (a = b)
    | [], [] => isTrue rfl
    | [], _ :: _ => isFalse (by intro h; cases h)
    | _ :: _, [] => isFalse (by intro h; cases h)
    | a :: as, b :: bs => by
      letI : Decidable (a = b) := heapEq a b
      letI : Decidable (as = bs) := heapListEq as bs
      exact decidable_of_iff (a = b ∧ as = bs) (by simp)
  def valListEq : (a b : List ValType) → Decidable (a = b)
    | [], [] => isTrue rfl
    | [], _ :: _ => isFalse (by intro h; cases h)
    | _ :: _, [] => isFalse (by intro h; cases h)
    | a :: as, b :: bs => by
      letI : Decidable (a = b) := valEq a b
      letI : Decidable (as = bs) := valListEq as bs
      exact decidable_of_iff (a = b ∧ as = bs) (by simp)
  def fieldListEq : (a b : List FieldType) → Decidable (a = b)
    | [], [] => isTrue rfl
    | [], _ :: _ => isFalse (by intro h; cases h)
    | _ :: _, [] => isFalse (by intro h; cases h)
    | a :: as, b :: bs => by
      letI : Decidable (a = b) := fieldEq a b
      letI : Decidable (as = bs) := fieldListEq as bs
      exact decidable_of_iff (a = b ∧ as = bs) (by simp)
end
instance : DecidableEq HeapType := heapEq
instance : DecidableEq ValType := valEq
instance : DecidableEq StorageType := storageEq
instance : DecidableEq FieldType := fieldEq
instance : DecidableEq SubType := subEq
deriving instance DecidableEq for RefType, FuncType, CompType, DefinedType
end Wasm.Types
