import Lean
import Wasm.VectorValidation
open Lean Elab Tactic
private partial def stringsIn : Expr → List String
  | .lit (.strVal s) => [s]
  | .app f a => stringsIn f ++ stringsIn a
  | .lam _ t b _ | .forallE _ t b _ => stringsIn t ++ stringsIn b
  | .letE _ t v b _ => stringsIn t ++ stringsIn v ++ stringsIn b
  | .mdata _ e | .proj _ _ e => stringsIn e
  | _ => []
elab "string_list_facts" : tactic => do
  for s in (stringsIn (← getMainTarget)).eraseDups do
    let literal := quote s
    let chars := quote s.toList
    evalTactic (← `(tactic| have : ($literal).toList = $chars := by decide +kernel))

