set_option maxHeartbeats 2000000 in
set_option linter.unusedSimpArgs false in
theorem name_split (opcode : VectorOpcode) : opcode.name.splitOn "." = nameParts opcode := by
  cases opcode <;> dsimp only [VectorOpcode.name, nameParts]
  all_goals string_list_facts
  all_goals simp_all +decide [String.splitOn, String.splitOnAux, String.Pos.Raw.next,
    String.Pos.Raw.get, String.Pos.Raw.extract, String.Pos.Raw.extract.go₁,
      String.Pos.Raw.extract.go₂, String.Pos.Raw.utf8GetAux, String.Pos.Raw.unoffsetBy]

#print axioms name_split
end Wasm.VectorProofs
