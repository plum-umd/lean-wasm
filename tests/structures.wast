(module
  (type $s (struct (field $packed (mut i8)) (field $wide i64) (field $ref anyref)))
  (func (export "unsigned") (param i32) (result i32)
    (struct.get_u $s $packed (struct.new $s (local.get 0) (i64.const 42) (ref.null any))))
  (func (export "signed") (param i32) (result i32)
    (struct.get_s $s $packed (struct.new $s (local.get 0) (i64.const 42) (ref.null any))))
  (func (export "wide") (result i64)
    (struct.get $s $wide (struct.new $s (i32.const 7) (i64.const 42) (ref.null any))))
  (func (export "default") (result i32 i64 i32) (local (ref null $s))
    struct.new_default $s local.set 0
    local.get 0 struct.get_u $s $packed
    local.get 0 struct.get $s $wide
    local.get 0 struct.get $s $ref ref.is_null)
  (func (export "set") (param i32) (result i32) (local (ref null $s))
    struct.new_default $s local.set 1
    local.get 1 local.get 0 struct.set $s $packed
    local.get 1 struct.get_u $s $packed)
  (func (export "null") (result i32)
    ref.null $s struct.get_u $s $packed)
  (func (export "identity") (result i32)
    struct.new_default $s struct.new_default $s ref.eq)
)
(assert_return (invoke "unsigned" (i32.const 511)) (i32.const 255))
(assert_return (invoke "signed" (i32.const 255)) (i32.const -1))
(assert_return (invoke "wide") (i64.const 42))
(assert_return (invoke "default") (i32.const 0) (i64.const 0) (i32.const 1))
(assert_return (invoke "set" (i32.const 511)) (i32.const 255))
(assert_trap (invoke "null") "null struct reference")
(assert_return (invoke "identity") (i32.const 0))
(assert_invalid (module (type $s (struct (field i8)))
  (func (param (ref null $s)) (result i32) local.get 0 struct.get $s 0)) "type mismatch")
(assert_invalid (module (type $s (struct (field i32)))
  (func (param (ref null $s)) (result i32) local.get 0 struct.get_s $s 0)) "type mismatch")
(assert_invalid (module (type $s (struct (field i32)))
  (func (param (ref null $s)) local.get 0 i32.const 1 struct.set $s 0)) "immutable field")
(assert_invalid (module (type $s (struct (field (ref any))))
  (func (result (ref $s)) struct.new_default $s)) "type mismatch")

(module
  (type $s (struct (field $value (mut i32))))
  (type $signature (func (result i32)))
  (type $holder (struct (field (ref $signature))))
  (global $first (ref $s) (struct.new $s (i32.const 42)))
  (global $alias (ref $s) (global.get $first))
  (global $second (ref $s) (struct.new $s (i32.const 42)))
  (global $function (ref $holder) (struct.new $holder (ref.func $target)))
  (table $table 1 (ref $s) (struct.new $s (i32.const 0)))
  (elem (ref $s) (item (struct.new $s (i32.const 7))))
  (func $target (type $signature) (result i32) i32.const 99)
  (func (export "alias") (result i32) global.get $first global.get $alias ref.eq)
  (func (export "distinct") (result i32) global.get $first global.get $second ref.eq)
  (func (export "set")
    global.get $first i32.const 123 struct.set $s $value
    i32.const 0 global.get $first table.set $table)
  (func (export "get") (result i32) global.get $alias struct.get $s $value)
  (func (export "table") (result i32) i32.const 0 table.get $table struct.get $s $value)
  (func (export "function") (result i32)
    global.get $function struct.get $holder 0 call_ref $signature)
)
(assert_return (invoke "alias") (i32.const 1))
(assert_return (invoke "distinct") (i32.const 0))
(invoke "set")
(assert_return (invoke "get") (i32.const 123))
(assert_return (invoke "table") (i32.const 123))
(assert_return (invoke "function") (i32.const 99))
