(module definition $large (memory 65536))
(module $old (func (export "old") (result i32) (i32.const 9)))
(module definition $counter
  (global $g (mut i32) (i32.const 0))
  (func $start (global.set $g (i32.const 1)))
  (start $start)
  (func (export "get") (result i32) (global.get $g))
  (func (export "inc") (global.set $g (i32.add (global.get $g) (i32.const 1)))))
(assert_return (invoke "old") (i32.const 9))
(module instance $a $counter)
(assert_return (invoke "get") (i32.const 1))
(invoke "inc")
(module instance $b $counter)
(assert_return (invoke $a "get") (i32.const 2))
(assert_return (invoke $b "get") (i32.const 1))
(module instance $counter)
(assert_return (invoke "get") (i32.const 1))
(module instance)
(assert_return (invoke "get") (i32.const 1))
(module $provider (global (export "g") (mut i32) (i32.const 10)))
(register "provider")
(module definition $importer
  (global $g (import "provider" "g") (mut i32))
  (func (export "get") (result i32) (global.get $g)))
(module $provider2 (global (export "g") (mut i32) (i32.const 20)))
(register "provider")
(module instance $importer)
(assert_return (invoke "get") (i32.const 20))

;; Defined memories and tables are fresh for each instance.
(module definition $resources
  (memory (export "m") 1)
  (table (export "t") 1 externref)
  (func (export "write")
    (i32.store (i32.const 0) (i32.const 7)))
  (func (export "read") (result i32) (i32.load (i32.const 0)))
  (func (export "put") (param externref)
    (table.set (i32.const 0) (local.get 0)))
  (func (export "get") (result externref) (table.get (i32.const 0))))
(module instance $r1 $resources)
(invoke "write")
(invoke "put" (ref.extern 5))
(module instance $r2 $resources)
(assert_return (invoke "read") (i32.const 0))
(assert_return (invoke "get") (ref.null))
(assert_return (invoke $r1 "read") (i32.const 7))
(assert_return (invoke $r1 "get") (ref.extern 5))

;; Importing the same resource twice preserves its identity.
(register "resources" $r1)
(module
  (import "resources" "m" (memory $m1 1))
  (import "resources" "m" (memory $m2 1))
  (func (export "alias") (result i32)
    (i32.store $m1 (i32.const 0) (i32.const 11))
    (i32.load $m2 (i32.const 0))))
(assert_return (invoke "alias") (i32.const 11))
(assert_return (invoke $r1 "read") (i32.const 11))

;; Definition validation runs no start function. Trapping starts keep imported effects.
(module definition $trapping
  (import "provider" "g" (global $g (mut i32)))
  (func $start (global.set $g (i32.const 99)) unreachable)
  (start $start))
(assert_return (get $provider2 "g") (i32.const 20))
(assert_trap (module instance $trapping) "unreachable")
(assert_return (get $provider2 "g") (i32.const 99))
(module definition $unlinked
  (import "absent" "f" (func)))
(assert_unlinkable (module instance $unlinked) "unknown import")
