(module
  (type $sig (func (param i32) (result i32)))
  (type $other (func (param i64) (result i64)))
  (func $id (type $sig) local.get 0)
  (func $other (type $other) local.get 0)
  (func $trap (type $sig) unreachable)
  (func $void)
  (func (export "default") (param i32 i32) (result i32)
    local.get 0 local.get 1 call_indirect (type $sig))
  (func (export "named") (param i32 i32) (result i32)
    (call_indirect $main (param i32) (result i32) (local.get 0) (local.get 1)))
  (func (export "numeric") (param i32) (result i32)
    local.get 0 i32.const 0 call_indirect 0 (type 0) (param i32) (result i32))
  (func (export "wide") (param i32 i64) (result i32)
    local.get 0 local.get 1 call_indirect $wide (type $sig))
  (func (export "inline") (param i32) (result i32)
    local.get 0 i32.const 0 call_indirect $inline (type $sig))
  (func (export "void") i32.const 1 call_indirect $inline)
  (func (export "dead") (result i32) unreachable call_indirect (type $sig))
  (table $main (export "main") 4 8 funcref)
  (table $external 1 externref)
  (table $wide i64 1 2 funcref)
  (table $inline funcref (elem $id $void))
  (elem $active (i32.const 0) func $id $other)
  (elem (table $main) (offset (i32.const 2)) funcref (ref.null func) (ref.func $trap))
  (elem (table $wide) (offset (i64.const 0)) func $id)
  (elem $passive func $id)
  (elem $declaration declare func $void)
  (export "wide-table" (table $wide)))
(assert_return (invoke "default" (i32.const 7) (i32.const 0)) (i32.const 7))
(assert_return (invoke "named" (i32.const 8) (i32.const 0)) (i32.const 8))
(assert_return (invoke "numeric" (i32.const 9)) (i32.const 9))
(assert_return (invoke "wide" (i32.const 10) (i64.const 0)) (i32.const 10))
(assert_return (invoke "inline" (i32.const 11)) (i32.const 11))
(assert_return (invoke "void"))
(assert_trap (invoke "default" (i32.const 0) (i32.const 1)) "indirect call type mismatch")
(assert_trap (invoke "default" (i32.const 0) (i32.const 2)) "uninitialized element")
(assert_trap (invoke "default" (i32.const 0) (i32.const 3)) "unreachable")
(assert_trap (invoke "default" (i32.const 0) (i32.const 4)) "undefined element")
(assert_trap (invoke "default" (i32.const 0) (i32.const -1)) "undefined element")
(assert_trap (invoke "wide" (i32.const 0) (i64.const 1)) "undefined element")
(assert_trap (invoke "wide" (i32.const 0) (i64.const 4294967296)) "undefined element")
(assert_trap (invoke "dead") "unreachable")

(assert_invalid (module (func i32.const 0 call_indirect)) "unknown table")
(assert_invalid (module (table 1 externref) (func i32.const 0 call_indirect)) "type mismatch")
(assert_invalid (module (table 1 funcref) (func i32.const 0 call_indirect 1)) "unknown table")
(assert_invalid (module (table 1 funcref) (func i64.const 0 call_indirect)) "type mismatch")
(assert_invalid (module (table i64 1 funcref) (func i32.const 0 call_indirect)) "type mismatch")
(assert_invalid (module (type (func (param i32))) (table 1 funcref)
  (func i64.const 0 i32.const 0 call_indirect (type 0))) "type mismatch")
(assert_invalid (module (table 1 funcref) (func unreachable call_indirect 1)) "unknown table")
(assert_invalid (module (table 2 1 funcref)) "size minimum must not be greater than maximum")
(assert_invalid (module (table 4294967296 funcref)) "table size must be at most 4294967295")
(assert_invalid (module (table 0 4294967296 funcref)) "table size must be at most 4294967295")
(assert_invalid (module (table 1 funcref) (elem (i32.const 0) func 0)) "unknown function")
(assert_invalid (module (func) (table 1 funcref)
  (elem (table 1) (i32.const 0) func 0)) "unknown table")
(assert_invalid (module (func) (table 1 externref) (elem (i32.const 0) func 0)) "type mismatch")
(assert_invalid (module (func) (table i64 1 funcref) (elem (i32.const 0) func 0)) "type mismatch")
(assert_invalid (module (table 1 funcref) (export "bad" (table 1))) "unknown table")
