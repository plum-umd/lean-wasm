(module $host
  (import "spectest" "print" (func $print))
  (import "spectest" "print_i32" (func $i32 (param i32)))
  (import "spectest" "print_i64" (func $i64 (param i64)))
  (import "spectest" "print_f32" (func $f32 (param f32)))
  (import "spectest" "print_f64" (func $f64 (param f64)))
  (import "spectest" "print_i32_f32" (func $pair (param i32 f32)))
  (import "spectest" "print_f64_f64" (func $double (param f64 f64)))
  (import "spectest" "global_i32" (global $g32 i32))
  (import "spectest" "global_i64" (global $g64 i64))
  (import "spectest" "global_f32" (global $gf32 f32))
  (import "spectest" "global_f64" (global $gf64 f64))
  (import "spectest" "memory" (memory 1 2))
  (import "spectest" "table" (table 10 20 funcref))
  (import "spectest" "table64" (table $wide i64 10 20 funcref))
  (export "print" (func $print))
  (export "print-i32" (func $i32))
  (export "g32" (global $g32))
  (export "g64" (global $g64))
  (export "gf32" (global $gf32))
  (export "gf64" (global $gf64))
  (func $start (call $i32 (i32.const 42)))
  (start $start)
  (func (export "prints")
    (block (call $print) (call $i32 (i32.const -1)))
    (call $i64 (i64.const 2))
    (call $f32 (f32.const 3))
    (call $f64 (f64.const 4))
    (call $pair (i32.const 5) (f32.const 6))
    (call $double (f64.const 7) (f64.const 8)))
  (func (export "sizes") (result i32 i32 i64)
    (memory.size) (table.size 0) (table.size $wide))
  (func (export "zero") (result i32) (i32.load (i32.const 0)))
  (func (export "write") (i32.store (i32.const 0) (i32.const 123)))
  (func (export "grow") (result i32) (memory.grow (i32.const 1)))
  (func (export "grow-table") (result i32)
    (table.grow 0 (ref.null func) (i32.const 1)))
  (func (export "indirect") (call_indirect (type 1) (i32.const 99) (i32.const 0)))
  (elem (i32.const 0) func $i32))
(assert_return (get $host "g32") (i32.const 666))
(assert_return (get $host "g64") (i64.const 666))
(assert_return (get $host "gf32") (f32.const 666.6))
(assert_return (get $host "gf64") (f64.const 666.6))
(assert_return (invoke $host "print"))
(assert_return (invoke $host "print-i32" (i32.const 17)))
(assert_return (invoke $host "prints"))
(assert_return (invoke $host "indirect"))
(assert_return (invoke $host "sizes") (i32.const 1) (i32.const 10) (i64.const 10))
(assert_return (invoke $host "zero") (i32.const 0))
(invoke $host "write")
(assert_return (invoke $host "grow") (i32.const 1))
(assert_return (invoke $host "grow-table") (i32.const 10))
(module
  (import "spectest" "memory" (memory 1 2))
  (import "spectest" "table" (table 10 20 funcref))
  (func (export "read") (result i32) (i32.load (i32.const 0)))
  (func (export "sizes") (result i32 i32) (memory.size) (table.size 0)))
(assert_return (invoke "read") (i32.const 123))
(assert_return (invoke "sizes") (i32.const 2) (i32.const 11))
(assert_unlinkable (module (import "spectest" "missing" (func))) "unknown import")
(assert_unlinkable (module (import "spectest" "print_i32" (func (param i64)))) "type mismatch")
(assert_unlinkable (module (import "spectest" "global_i32" (global (mut i32)))) "type mismatch")
(assert_unlinkable (module (import "spectest" "memory" (memory 1 1))) "type mismatch")
(assert_unlinkable (module (import "spectest" "table" (table 10 10 funcref))) "type mismatch")
(assert_invalid (module (import "spectest" "global_i32" (global i32))
  (func (global.set 0 (i32.const 1)))) "immutable global")
