(module
  (type $a (array (mut i32)))
  (data $empty "")
  (func (export "new")
    i32.const 0 i32.const 1048577 array.new $a drop)
  (func (export "default")
    i32.const 1048577 array.new_default $a drop)
  (func (export "small") (result i32)
    i32.const 7 i32.const 2 array.new $a array.len)
  (func (export "bounds")
    i32.const 0 i32.const 1048577 array.new_data $a $empty drop))
(assert_exhaustion (invoke "new") "allocation limit")
(assert_exhaustion (invoke "default") "allocation limit")
(assert_return (invoke "small") (i32.const 2))
(assert_trap (invoke "bounds") "out of bounds array access")
