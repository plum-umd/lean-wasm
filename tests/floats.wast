;; Native execution is tested here; validation success remains kernel proved.
(module $F
  (memory 1)
  (global $g (export "g") (mut f32) (f32.const -0))
  (global $h (export "h") f64 (f64.const 0x1.8p+1))
  (func $start (global.set $g (f32.add (f32.const 1.5) (f32.const 2.5))))
  (start $start)
  (func $inc (param f32) (result f32)
    (block (result f32) (f32.add (local.get 0) (f32.const 1))))
  (func (export "nested") (param f32) (result f32)
    (if (result f32) (i32.const 1)
      (then (call $inc (local.get 0))) (else (f32.const 0))))
  (func (export "default") (result f64) (local f64) local.get 0)
  (func (export "memory") (param i32) (result i32)
    (f32.store offset=4 (i32.const 0) (f32.reinterpret_i32 (local.get 0)))
    (i32.reinterpret_f32 (f32.load offset=4 (i32.const 0))))
  (func (export "global") (param f32) (result f32)
    local.get 0 global.set $g global.get $g)
  (func (export "convert") (param f64) (result i64) local.get 0 i64.trunc_f64_s)
  (func (export "neg") (param f32) (result f32) local.get 0 f32.neg)
  (func (export "abs") (param f64) (result f64) local.get 0 f64.abs)
  (func (export "copy-sign") (param f64 f64) (result f64)
    local.get 0 local.get 1 f64.copysign)
  (func (export "nearest") (param f32) (result f32) local.get 0 f32.nearest)
  (func (export "min") (param f32 f32) (result f32) local.get 0 local.get 1 f32.min)
  (func (export "max") (param f64 f64) (result f64) local.get 0 local.get 1 f64.max)
  (func (export "nan") (result f32) (f32.div (f32.const 0) (f32.const 0)))
  (func (export "select") (param f32 f32 i32) (result f32)
    local.get 0 local.get 1 local.get 2 select))
(assert_return (get "g") (f32.const 4))
(assert_return (get "h") (f64.const 3))
(assert_return (invoke "nested" (f32.const 1.5)) (f32.const 2.5))
(assert_return (invoke "default") (f64.const 0))
(assert_return (invoke "memory" (i32.const 0x7f800001)) (i32.const 0x7f800001))
(assert_return (invoke "memory" (i32.const 0x80000000)) (i32.const 0x80000000))
(assert_return (invoke "global" (f32.const nan:0x12345)) (f32.const nan:0x12345))
(assert_return (invoke "neg" (f32.const nan:0x12345)) (f32.const -nan:0x12345))
(assert_return (invoke "abs" (f64.const -nan:0x12345)) (f64.const nan:0x12345))
(assert_return (invoke "copy-sign" (f64.const nan:0x12345) (f64.const -0))
  (f64.const -nan:0x12345))
(assert_return (invoke "nearest" (f32.const 0.5)) (f32.const 0))
(assert_return (invoke "nearest" (f32.const -0.5)) (f32.const -0))
(assert_return (invoke "nearest" (f32.const 1.5)) (f32.const 2))
(assert_return (invoke "nearest" (f32.const 2.5)) (f32.const 2))
(assert_return (invoke "min" (f32.const 0) (f32.const -0)) (f32.const -0))
(assert_return (invoke "max" (f64.const -0) (f64.const 0)) (f64.const 0))
(assert_return (invoke "nan") (f32.const nan:canonical))
(assert_return (invoke "nan") (f32.const nan:arithmetic))
(assert_return (invoke "select" (f32.const -0) (f32.const 0) (i32.const 1)) (f32.const -0))
(assert_return (invoke "convert" (f64.const -9223372036854775808)) (i64.const -9223372036854775808))
(assert_trap (invoke "convert" (f64.const 9223372036854775808)) "integer overflow")
(assert_trap (invoke "convert" (f64.const nan)) "invalid conversion to integer")
(register "floats" $F)
(module (global $shared (import "floats" "g") (mut f32))
  (func (export "change") (global.set $shared (f32.sqrt (f32.const 9)))))
(assert_return (invoke "change"))
(assert_return (get $F "g") (f32.const 3))
(assert_invalid (module (func (result f32) i32.const 0 f32.sqrt)) "operand type")
(assert_invalid (module (func (result f64) f32.const 0 f32.sqrt)) "result type")
(assert_invalid (module (func f64.const 0 f64.const 0 f32.add drop)) "width mismatch")
(assert_invalid (module (func f32.const 0 i32.const 0 f32.eq drop)) "comparison operands")
(assert_invalid (module (func i64.const 0 i32.reinterpret_f32 drop)) "reinterpret operands")
(assert_invalid (module (func f32.const 0 f64.const 0 i32.const 1 select drop)) "select operands")
(module (func (result f32) unreachable select))
