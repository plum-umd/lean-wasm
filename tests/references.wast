(module $refs
  (type $sig (func (param i32) (result i32)))
  (func $id (type $sig) local.get 0)
  (func $increment (type $sig) local.get 0 i32.const 1 i32.add)
  (elem declare func $id $increment)
  (table $funcs (export "funcs") 1 funcref)
  (table $externs 1 externref)
  (table $wide i64 1 funcref)
  (func (export "null") (result funcref) ref.null func)
  (func (export "func") (result funcref) ref.func $id)
  (func (export "default") (result funcref) (local $r funcref) local.get $r)
  (func (export "id-extern") (param $r externref) (result externref)
    (local $copy (ref null extern)) local.get $r local.tee $copy drop local.get $copy)
  (func $idref (param funcref) (result funcref) local.get 0)
  (func (export "call-ref") (result funcref) ref.func $id call $idref)
  (func (export "branch") (result funcref)
    (block (result funcref) (ref.func $id) br 0))
  (func (export "select") (param i32) (result funcref)
    ref.null func ref.func $id local.get 0 select (result funcref))
  (func (export "is-null") (param funcref) (result i32) local.get 0 ref.is_null)
  (func (export "dead") (result i32) unreachable ref.is_null)
  (func (export "size") (result i32) table.size)
  (func (export "size-wide") (result i64) (table.size $wide))
  (func (export "get") (param i32) (result funcref) local.get 0 table.get)
  (func (export "put") (param i32) local.get 0 ref.func $increment table.set)
  (func (export "clear") i32.const 0 ref.null func table.set 0)
  (func (export "call") (param i32) (result i32)
    local.get 0 i32.const 0 call_indirect (type $sig))
  (func (export "put-extern") (param externref)
    (table.set $externs (i32.const 0) (local.get 0)))
  (func (export "get-extern") (result externref) i32.const 0 table.get $externs)
  (func (export "put-wide") (param i64) local.get 0 ref.func $id table.set $wide)
  (func (export "get-wide") (param i64) (result funcref) local.get 0 table.get $wide))
(assert_return (invoke "null") (ref.null func))
(assert_return (invoke "default") (ref.null))
(assert_return (invoke "func") (ref.func))
(assert_return (invoke "call-ref") (ref.func))
(assert_return (invoke "branch") (ref.func))
(assert_return (invoke "id-extern" (ref.extern 17)) (ref.extern 17))
(assert_return (invoke "id-extern" (ref.null extern)) (ref.null extern))
(assert_return (invoke "select" (i32.const 1)) (ref.null func))
(assert_return (invoke "select" (i32.const 0)) (ref.func))
(assert_return (invoke "is-null" (ref.null func)) (i32.const 1))
(assert_trap (invoke "dead") "unreachable")
(assert_return (invoke "size") (i32.const 1))
(assert_return (invoke "size-wide") (i64.const 1))
(assert_return (invoke "get" (i32.const 0)) (ref.null func))
(assert_return (invoke "put" (i32.const 0)))
(assert_return (invoke "get" (i32.const 0)) (ref.func))
(assert_return (invoke "call" (i32.const 41)) (i32.const 42))
(assert_return (invoke "clear"))
(assert_trap (invoke "call" (i32.const 0)) "uninitialized element")
(assert_trap (invoke "get" (i32.const 1)) "out of bounds table access")
(assert_trap (invoke "put" (i32.const -1)) "out of bounds table access")
(assert_return (invoke "get-extern") (ref.null extern))
(assert_return (invoke "put-extern" (ref.extern 9)))
(assert_return (invoke "get-extern") (ref.extern))
(assert_return (invoke "get-extern") (ref.extern 9))
(assert_return (invoke "put-wide" (i64.const 0)))
(assert_return (invoke "get-wide" (i64.const 0)) (ref.func))
(assert_trap (invoke "get-wide" (i64.const 4294967296)) "out of bounds table access")
(assert_trap (invoke "put-wide" (i64.const -1)) "out of bounds table access")

(assert_invalid (module (func (param i32) local.get 0 ref.is_null drop)) "type mismatch")
(assert_invalid (module (func ref.is_null drop)) "type mismatch")
(assert_invalid (module (func (param funcref) (result externref) local.get 0)) "type mismatch")
(assert_invalid (module (func (result funcref) ref.func 99)) "unknown function")
(assert_invalid (module (func $f (result funcref) ref.func $f)) "undeclared function reference")
(assert_invalid (module (func unreachable ref.func 99 drop)) "unknown function")
(assert_invalid (module (func (result funcref)
  ref.null func ref.null func i32.const 0 select)) "type mismatch")
(assert_invalid (module (func (result funcref)
  ref.null func ref.null extern i32.const 0 select (result funcref))) "type mismatch")
(assert_invalid (module (table 1 funcref) (func i32.const 0 ref.null extern table.set)) "type mismatch")
(assert_invalid (module (table 1 funcref) (func i64.const 0 table.get drop)) "type mismatch")
(assert_invalid (module (table i64 1 funcref) (func i32.const 0 table.get drop)) "type mismatch")
(assert_invalid (module (table 1 funcref) (func table.size 1 drop)) "unknown table")
(assert_invalid (module (table 1 funcref) (func unreachable table.get 1 drop)) "unknown table")
(assert_invalid (module (table 1 funcref) (func (result i64) table.size)) "type mismatch")
(assert_invalid (module (func (result funcref) (local funcref) i32.const 0 local.set 0 local.get 0))
  "type mismatch")

;; Starting a function does not declare it as a ref.func target.
(assert_invalid (module (start $f) (func $f ref.func $f drop)) "undeclared function reference")
(module (func $start) (start $start))
