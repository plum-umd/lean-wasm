;; Mixed address widths, initializer identity, and failure without mutation.
(module
  (table $small 1 3 externref)
  (table $wide i64 0 2 funcref)
  (func $f)
  (elem declare func $f)
  (func (export "grow") (param externref i32) (result i32)
    local.get 0 local.get 1 table.grow)
  (func (export "size") (result i32) table.size)
  (func (export "get") (param i32) (result externref) local.get 0 table.get)
  (func (export "grow-wide") (param i64) (result i64)
    (table.grow $wide (ref.func $f) (local.get 0)))
  (func (export "size-wide") (result i64) table.size $wide)
  (func (export "get-wide") (param i64) (result funcref) local.get 0 table.get $wide))
(assert_return (invoke "grow" (ref.extern 7) (i32.const 2)) (i32.const 1))
(assert_return (invoke "size") (i32.const 3))
(assert_return (invoke "get" (i32.const 0)) (ref.null extern))
(assert_return (invoke "get" (i32.const 1)) (ref.extern 7))
(assert_return (invoke "get" (i32.const 2)) (ref.extern 7))
(assert_return (invoke "grow" (ref.extern 8) (i32.const 0)) (i32.const 3))
(assert_return (invoke "grow" (ref.extern 8) (i32.const 1)) (i32.const -1))
(assert_return (invoke "grow" (ref.extern 8) (i32.const -1)) (i32.const -1))
(assert_return (invoke "size") (i32.const 3))
(assert_return (invoke "get" (i32.const 2)) (ref.extern 7))
(assert_trap (invoke "get" (i32.const 3)) "out of bounds table access")
(assert_return (invoke "grow-wide" (i64.const 1)) (i64.const 0))
(assert_return (invoke "get-wide" (i64.const 0)) (ref.func))
(assert_return (invoke "grow-wide" (i64.const 0)) (i64.const 1))
(assert_return (invoke "grow-wide" (i64.const 1)) (i64.const 1))
(assert_return (invoke "grow-wide" (i64.const 1)) (i64.const -1))
(assert_return (invoke "grow-wide" (i64.const 4294967296)) (i64.const -1))
(assert_return (invoke "grow-wide" (i64.const -1)) (i64.const -1))
(assert_return (invoke "size-wide") (i64.const 2))
(assert_return (invoke "get-wide" (i64.const 1)) (ref.func))
(assert_trap (invoke "get-wide" (i64.const 2)) "out of bounds table access")

(assert_invalid (module (table 0 funcref)
  (func (result i32) i32.const 1 ref.null func table.grow)) "type mismatch")
(assert_invalid (module (table 0 funcref)
  (func (result i32) ref.null extern i32.const 1 table.grow)) "type mismatch")
(assert_invalid (module (table 0 funcref)
  (func (result i32) ref.null func i64.const 1 table.grow)) "type mismatch")
(assert_invalid (module (table i64 0 funcref)
  (func (result i64) ref.null func i32.const 1 table.grow)) "type mismatch")
(assert_invalid (module (table i64 0 funcref)
  (func (result i32) ref.null func i64.const 1 table.grow)) "type mismatch")
(assert_invalid (module (table 0 funcref)
  (func ref.null func i32.const 1 table.grow)) "type mismatch")
(assert_invalid (module (table 0 funcref)
  (func (result i32) table.grow)) "type mismatch")
(assert_invalid (module (table 0 funcref)
  (func unreachable table.grow 1 drop)) "unknown table")
(assert_invalid (module (table 0 funcref)
  (func unreachable i32.const 1 i32.const 1 table.grow drop)) "type mismatch")
(module (table i64 0 funcref) (func (result i64) unreachable table.grow))
