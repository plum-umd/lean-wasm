;; Explicit declarations precede inferred types even when written later.
(module
  (func $id (export "id") (type $idtype) local.get 0)
  (type $idtype (func (param $documentation i32) (result i32)))
  (type $pair (func (param i32 i64) (result i32 i64)))
  (type $result (func (result i32)))
  (type $void (func))
  (func (export "named") (type 0) (param $x i32) (result i32)
    (local $scratch i32)
    local.get $x local.set $scratch local.get $scratch)
  (func (export "inherited") (type $idtype) (local $scratch i32)
    local.get 0 local.set $scratch local.get 1)
  (func (export "pair") (param i32 i64) (result i32 i64)
    local.get 0 local.get 1 block (type $pair) end)
  (func (export "loop") (param i32 i64) (result i32 i64)
    local.get 0 local.get 1 (loop (type 1) (param i32 i64) (result i32 i64)))
  (func (export "if") (result i32)
    (if (type $result) (i32.const 1) (then i32.const 42) (else i32.const 99)))
  (func (export "if-flat") (result i32)
    i32.const 0 if (type 2) i32.const 42 else i32.const 99 end)
  (func (export "call") (type $idtype) local.get 0 call $id)
  (func (export "void") (type $void) (param) (result) (block (type $void))))
(assert_return (invoke "id" (i32.const 7)) (i32.const 7))
(assert_return (invoke "named" (i32.const 8)) (i32.const 8))
(assert_return (invoke "inherited" (i32.const 9)) (i32.const 9))
(assert_return (invoke "pair" (i32.const 1) (i64.const 2)) (i32.const 1) (i64.const 2))
(assert_return (invoke "loop" (i32.const 3) (i64.const 4)) (i32.const 3) (i64.const 4))
(assert_return (invoke "if") (i32.const 42))
(assert_return (invoke "if-flat") (i32.const 99))
(assert_return (invoke "call" (i32.const 10)) (i32.const 10))
(assert_return (invoke "void"))

;; Valid text with invalid instruction typing still reaches the validator.
(assert_invalid (module (type $t (func (result i32)))
  (func (type $t) i64.const 0)) "type mismatch")
(assert_invalid (module (type $t (func (param i32) (result i32)))
  (func (result i32) (block (type $t)))) "type mismatch")
(assert_invalid (module (type $t (func (result i32)))
  (func (result i32) (if (type $t) (i32.const 1) (then i32.const 0)))) "type mismatch")
