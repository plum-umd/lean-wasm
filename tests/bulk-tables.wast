;; Copies preserve external identities and support both overlap directions.
(module
  (table $small 5 externref)
  (table $wide i64 5 externref)
  (table $wide2 i64 5 externref)
  (func (export "put") (param i32 externref)
    local.get 0 local.get 1 table.set)
  (func (export "get") (param i32) (result externref) local.get 0 table.get)
  (func (export "fill") (param i32 externref i32)
    local.get 0 local.get 1 local.get 2 table.fill)
  (func (export "copy") (param i32 i32 i32)
    local.get 0 local.get 1 local.get 2 table.copy)
  (func (export "fill-wide") (param i64 externref i64)
    (table.fill $wide (local.get 0) (local.get 1) (local.get 2)))
  (func (export "get-wide") (param i64) (result externref) local.get 0 table.get $wide)
  (func (export "to-wide") (param i64 i32 i32)
    local.get 0 local.get 1 local.get 2 table.copy $wide $small)
  (func (export "to-small") (param i32 i64 i32)
    (table.copy $small $wide (local.get 0) (local.get 1) (local.get 2)))
  (func (export "wide-copy") (param i64 i64 i64)
    local.get 0 local.get 1 local.get 2 table.copy $wide2 $wide)
  (func (export "get-wide2") (param i64) (result externref) local.get 0 table.get $wide2))
(assert_return (invoke "put" (i32.const 0) (ref.extern 1)))
(assert_return (invoke "put" (i32.const 1) (ref.extern 2)))
(assert_return (invoke "put" (i32.const 2) (ref.extern 3)))
(assert_return (invoke "put" (i32.const 3) (ref.extern 4)))
(assert_return (invoke "put" (i32.const 4) (ref.extern 5)))
(assert_return (invoke "copy" (i32.const 1) (i32.const 0) (i32.const 4)))
(assert_return (invoke "get" (i32.const 0)) (ref.extern 1))
(assert_return (invoke "get" (i32.const 1)) (ref.extern 1))
(assert_return (invoke "get" (i32.const 2)) (ref.extern 2))
(assert_return (invoke "get" (i32.const 3)) (ref.extern 3))
(assert_return (invoke "get" (i32.const 4)) (ref.extern 4))
(assert_return (invoke "copy" (i32.const 0) (i32.const 1) (i32.const 4)))
(assert_return (invoke "get" (i32.const 0)) (ref.extern 1))
(assert_return (invoke "get" (i32.const 1)) (ref.extern 2))
(assert_return (invoke "get" (i32.const 2)) (ref.extern 3))
(assert_return (invoke "get" (i32.const 3)) (ref.extern 4))
(assert_return (invoke "copy" (i32.const 5) (i32.const 5) (i32.const 0)))
(assert_trap (invoke "copy" (i32.const 6) (i32.const 5) (i32.const 0)) "bounds")
(assert_trap (invoke "copy" (i32.const 5) (i32.const 6) (i32.const 0)) "bounds")
(assert_trap (invoke "copy" (i32.const 1) (i32.const 0) (i32.const 5)) "bounds")
(assert_trap (invoke "copy" (i32.const 0) (i32.const 1) (i32.const 5)) "bounds")
(assert_return (invoke "get" (i32.const 0)) (ref.extern 1))
(assert_return (invoke "get" (i32.const 4)) (ref.extern 4))
(assert_return (invoke "fill" (i32.const 1) (ref.extern 9) (i32.const 2)))
(assert_return (invoke "get" (i32.const 0)) (ref.extern 1))
(assert_return (invoke "get" (i32.const 1)) (ref.extern 9))
(assert_return (invoke "get" (i32.const 2)) (ref.extern 9))
(assert_return (invoke "get" (i32.const 3)) (ref.extern 4))
(assert_return (invoke "fill" (i32.const 5) (ref.null extern) (i32.const 0)))
(assert_trap (invoke "fill" (i32.const 6) (ref.null extern) (i32.const 0)) "bounds")
(assert_trap (invoke "fill" (i32.const 4) (ref.extern 8) (i32.const 2)) "bounds")
(assert_return (invoke "get" (i32.const 4)) (ref.extern 4))
(assert_return (invoke "to-wide" (i64.const 1) (i32.const 0) (i32.const 3)))
(assert_return (invoke "get-wide" (i64.const 1)) (ref.extern 1))
(assert_return (invoke "get-wide" (i64.const 2)) (ref.extern 9))
(assert_return (invoke "fill-wide" (i64.const 3) (ref.extern 10) (i64.const 2)))
(assert_return (invoke "get-wide" (i64.const 4)) (ref.extern 10))
(assert_return (invoke "to-small" (i32.const 0) (i64.const 3) (i32.const 2)))
(assert_return (invoke "get" (i32.const 0)) (ref.extern 10))
(assert_return (invoke "get" (i32.const 1)) (ref.extern 10))
(assert_return (invoke "wide-copy" (i64.const 0) (i64.const 1) (i64.const 4)))
(assert_return (invoke "get-wide2" (i64.const 0)) (ref.extern 1))
(assert_return (invoke "get-wide2" (i64.const 3)) (ref.extern 10))
(assert_trap (invoke "to-wide" (i64.const 4294967296) (i32.const 0) (i32.const 0)) "bounds")
(assert_trap (invoke "to-small" (i32.const 0) (i64.const 4294967296) (i32.const 0)) "bounds")
(assert_trap (invoke "fill-wide" (i64.const 0) (ref.extern 11) (i64.const -1)) "bounds")
(assert_return (invoke "get-wide" (i64.const 0)) (ref.null extern))

;; Functions distinguish copied references. Inline table shorthand contributes
;; element index 0; $passive is index 1, $active is index 2, $declared is index 3.
(module
  (func $a (result i32) i32.const 11)
  (func $b (result i32) i32.const 22)
  (func $c (result i32) i32.const 33)
  (table $small funcref (elem $a $b $c))
  (elem $passive func $c $b $a)
  (table $wide i64 3 funcref)
  (elem $active (table $wide) (i64.const 0) func $a)
  (elem $declared declare func $b)
  (func (export "init") (param i32 i32 i32)
    local.get 0 local.get 1 local.get 2 table.init $passive)
  (func (export "init-wide") (param i64 i32 i32)
    (table.init $wide $passive (local.get 0) (local.get 1) (local.get 2)))
  (func (export "call") (param i32) (result i32)
    local.get 0 call_indirect (result i32))
  (func (export "call-wide") (param i64) (result i32)
    local.get 0 call_indirect $wide (result i32))
  (func (export "drop") elem.drop $passive)
  (func (export "active") (param i64 i32 i32)
    local.get 0 local.get 1 local.get 2 table.init $wide $active)
  (func (export "declared") (param i32 i32 i32)
    local.get 0 local.get 1 local.get 2 table.init 0 $declared)
  (func (export "inline") (param i32 i32 i32)
    local.get 0 local.get 1 local.get 2 table.init 0)
  (func (export "drop-active") elem.drop $active elem.drop $declared elem.drop 0))
(assert_return (invoke "call" (i32.const 0)) (i32.const 11))
(assert_return (invoke "call-wide" (i64.const 0)) (i32.const 11))
(assert_return (invoke "init" (i32.const 0) (i32.const 0) (i32.const 3)))
(assert_return (invoke "call" (i32.const 0)) (i32.const 33))
(assert_return (invoke "call" (i32.const 1)) (i32.const 22))
(assert_return (invoke "call" (i32.const 2)) (i32.const 11))
(assert_return (invoke "init-wide" (i64.const 1) (i32.const 1) (i32.const 2)))
(assert_return (invoke "call-wide" (i64.const 1)) (i32.const 22))
(assert_return (invoke "call-wide" (i64.const 2)) (i32.const 11))
(assert_return (invoke "init" (i32.const 3) (i32.const 3) (i32.const 0)))
(assert_trap (invoke "init" (i32.const 4) (i32.const 3) (i32.const 0)) "bounds")
(assert_trap (invoke "init" (i32.const 3) (i32.const 4) (i32.const 0)) "bounds")
(assert_trap (invoke "init" (i32.const 2) (i32.const 0) (i32.const 2)) "bounds")
(assert_trap (invoke "init" (i32.const 0) (i32.const 2) (i32.const 2)) "bounds")
(assert_return (invoke "call" (i32.const 0)) (i32.const 33))
(assert_return (invoke "call" (i32.const 2)) (i32.const 11))
(assert_trap (invoke "init-wide" (i64.const 4294967296) (i32.const 0) (i32.const 0)) "bounds")
(assert_return (invoke "active" (i64.const 3) (i32.const 0) (i32.const 0)))
(assert_trap (invoke "active" (i64.const 0) (i32.const 0) (i32.const 1)) "bounds")
(assert_return (invoke "declared" (i32.const 3) (i32.const 0) (i32.const 0)))
(assert_trap (invoke "declared" (i32.const 0) (i32.const 0) (i32.const 1)) "bounds")
(assert_return (invoke "inline" (i32.const 3) (i32.const 0) (i32.const 0)))
(assert_trap (invoke "inline" (i32.const 0) (i32.const 0) (i32.const 1)) "bounds")
(assert_return (invoke "drop-active"))
(assert_return (invoke "drop"))
(assert_return (invoke "drop"))
(assert_return (invoke "init" (i32.const 3) (i32.const 0) (i32.const 0)))
(assert_trap (invoke "init" (i32.const 0) (i32.const 0) (i32.const 1)) "bounds")
(assert_trap (invoke "init" (i32.const 0) (i32.const 1) (i32.const 0)) "bounds")
(assert_return (invoke "call" (i32.const 0)) (i32.const 33))
(assert_return (invoke "call-wide" (i64.const 1)) (i32.const 22))

;; Type/index errors are rejected even in unreachable code.
(assert_invalid (module (table 0 funcref)
  (func table.fill)) "type mismatch")
(assert_invalid (module (table 0 funcref)
  (func i32.const 0 ref.null extern i32.const 0 table.fill)) "type mismatch")
(assert_invalid (module (table i64 0 funcref)
  (func i64.const 0 ref.null func i32.const 0 table.fill)) "type mismatch")
(assert_invalid (module (table i64 0 funcref)
  (func i32.const 0 ref.null func i64.const 0 table.fill)) "type mismatch")
(assert_invalid (module (table 0 funcref)
  (func unreachable table.fill 1)) "unknown table")
(assert_invalid (module (table 0 funcref) (table 0 externref)
  (func i32.const 0 i32.const 0 i32.const 0 table.copy 0 1)) "type mismatch")
(assert_invalid (module (table 0 funcref) (table 0 externref)
  (func i32.const 0 i32.const 0 i32.const 0 table.copy 1 0)) "type mismatch")
(assert_invalid (module (table i64 0 funcref) (table 0 funcref)
  (func i64.const 0 i32.const 0 i64.const 0 table.copy 0 1)) "type mismatch")
(assert_invalid (module (table 0 funcref) (table i64 0 funcref)
  (func i32.const 0 i64.const 0 i64.const 0 table.copy 0 1)) "type mismatch")
(assert_invalid (module (table i64 0 funcref)
  (func i64.const 0 i64.const 0 i32.const 0 table.copy)) "type mismatch")
(assert_invalid (module (table 0 funcref)
  (func unreachable table.copy 1 0)) "unknown table")
(assert_invalid (module (table 0 funcref)
  (func unreachable table.copy 0 1)) "unknown table")
(assert_invalid (module (table 0 funcref) (elem func)
  (func table.init 0)) "type mismatch")
(assert_invalid (module (table 0 externref) (elem func)
  (func i32.const 0 i32.const 0 i32.const 0 table.init 0)) "type mismatch")
(assert_invalid (module (table i64 0 funcref) (elem func)
  (func i64.const 0 i64.const 0 i32.const 0 table.init 0)) "type mismatch")
(assert_invalid (module (table i64 0 funcref) (elem func)
  (func i64.const 0 i32.const 0 i64.const 0 table.init 0)) "type mismatch")
(assert_invalid (module (table i64 0 funcref) (elem func)
  (func i32.const 0 i32.const 0 i32.const 0 table.init 0)) "type mismatch")
(assert_invalid (module (table 0 funcref) (elem func)
  (func unreachable table.init 1 0)) "unknown table")
(assert_invalid (module (table 0 funcref) (elem func)
  (func unreachable table.init 0 1)) "unknown element")
(assert_invalid (module (elem func) (func elem.drop 1)) "unknown element")
(assert_invalid (module (func unreachable elem.drop 0)) "unknown element")
(assert_invalid (module (elem func) (func (result i32) elem.drop 0)) "type mismatch")
(module (table i64 0 funcref) (elem func)
  (func unreachable table.fill table.copy table.init 0 elem.drop 0))
