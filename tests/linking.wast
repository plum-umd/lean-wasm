(module $provider
  (type $sig (func (param i32) (result i32)))
  (table $t (export "table") 1 4 funcref)
  (table $wide (export "wide") i64 1 4 externref)
  (table (export "unbounded") 0 externref)
  (func $inc (export "inc") (type $sig) local.get 0 i32.const 1 i32.add)
  (func (export "id-ref") (param externref) (result externref) local.get 0)
  (func (export "noop"))
  (elem (table $t) (i32.const 0) func $inc)
  (func (export "call") (param i32) (result i32)
    local.get 0 i32.const 0 call_indirect $t (type $sig))
  (func (export "size") (result i32) table.size $t)
  (func (export "grow") (result i32)
    ref.func $inc i32.const 1 table.grow $t))
(register "provider")
(assert_return (invoke $provider "call" (i32.const 40)) (i32.const 41))
(assert_return (invoke $provider "grow") (i32.const 1))

;; Mixed import kinds have separate index spaces. Imported entities can be
;; re-exported; defined function/table indices follow the imported prefixes.
(module $consumer
  (type $sig (func (param i32) (result i32)))
  (import "provider" "inc" (func $inc (type $sig)))
  (table $shared (export "shared") (import "provider" "table") 2 4 funcref)
  (func $id-ref (export "ref") (import "provider" "id-ref")
    (param externref) (result externref))
  (import "provider" "wide" (table $wide i64 1 4 externref))
  (func $provider-size (import "provider" "size") (result i32))
  (table $private funcref (elem $inc))
  (func $double (export "double") (param i32) (result i32)
    local.get 0 call $inc call 0)
  (func (export "private") (result i32) table.size $private)
  (func (export "call-private") (param i32) (result i32)
    local.get 0 i32.const 0 call_indirect $private (type $sig))
  (func (export "provider-size") (result i32) call $provider-size)
  (func (export "size") (result i32) table.size $shared)
  (func (export "grow") (result i32)
    ref.null func i32.const 1 table.grow $shared)
  (func (export "clear") i32.const 0 ref.null func table.set $shared)
  (func (export "put-wide") (param externref)
    i64.const 0 local.get 0 table.set $wide)
  (func (export "get-wide") (result externref) i64.const 0 table.get $wide)
  (export "inc" (func $inc)))
(register "consumer" $consumer)
(assert_return (invoke "double" (i32.const 40)) (i32.const 42))
(assert_return (invoke "private") (i32.const 1))
(assert_return (invoke "call-private" (i32.const 40)) (i32.const 41))
(assert_return (invoke "size") (i32.const 2))
(assert_return (invoke "ref" (ref.extern 77)) (ref.extern 77))
(assert_return (invoke "grow") (i32.const 2))
(assert_return (invoke $provider "size") (i32.const 3))
(assert_return (invoke "provider-size") (i32.const 3))
(assert_return (invoke "put-wide" (ref.extern 88)))
(assert_return (invoke "get-wide") (ref.extern 88))
(assert_return (invoke "clear"))
(assert_trap (invoke $provider "call" (i32.const 40)) "uninitialized element")

(module $chain
  (func $f (import "consumer" "inc") (param i32) (result i32))
  (table $t (import "consumer" "shared") 3 funcref)
  (func (export "call") (param i32) (result i32) local.get 0 call $f)
  (func (export "size") (result i32) table.size $t))
(assert_return (invoke "call" (i32.const 99)) (i32.const 100))
(assert_return (invoke "size") (i32.const 3))
(register "old" $provider)

;; Registering another module under the same name changes future imports only.
(module $replacement (func (export "inc") (param i32) (result i32) local.get 0))
(register "provider" $replacement)
(module
  (func $f (import "provider" "inc") (param i32) (result i32))
  (func (export "call") (param i32) (result i32) local.get 0 call $f))
(assert_return (invoke "call" (i32.const 9)) (i32.const 9))
(assert_return (invoke $chain "call" (i32.const 9)) (i32.const 10))
(assert_return (invoke $consumer "double" (i32.const 9)) (i32.const 11))

;; A start function can itself be imported.
(module (import "old" "noop" (func $start)) (start $start))
(assert_unlinkable (module (import "missing" "inc" (func))) "unknown import")
(assert_unlinkable (module (import "old" "missing" (func))) "unknown import")
(assert_unlinkable (module (import "old" "table" (func))) "incompatible import type")
(assert_unlinkable (module (import "old" "inc" (table 0 funcref))) "incompatible import type")
(assert_unlinkable (module (import "old" "inc" (func (param i64) (result i64))))
  "incompatible import type")
(assert_unlinkable (module (import "old" "id-ref" (func (param funcref) (result funcref))))
  "incompatible import type")
(assert_unlinkable (module (import "old" "table" (table 4 funcref))) "incompatible import type")
(assert_unlinkable (module (import "old" "table" (table 0 3 funcref))) "incompatible import type")
(assert_unlinkable (module (import "old" "table" (table i64 0 funcref))) "incompatible import type")
(assert_unlinkable (module (import "old" "table" (table 0 externref))) "incompatible import type")
(assert_unlinkable (module (import "old" "unbounded" (table 0 10 externref)))
  "incompatible import type")
(module (import "old" "table" (table 0 5 funcref)))
(module (import "old" "table" (table 3 funcref)))
(module (import "old" "unbounded" (table 0 externref)))

;; Validation does not require an import provider.
(assert_invalid (module (type (func)) (import "missing" "f" (func (type 0)))
  (func call 2)) "unknown function")
(assert_invalid (module (import "missing" "t" (table 2 1 funcref))) "invalid limits")
(assert_invalid (module (import "missing" "t" (table 0 funcref))
  (func i64.const 0 table.get drop)) "type mismatch")
(assert_invalid (module (import "missing" "f" (func))
  (func ref.func 0 drop)) "undeclared function reference")
(module $refs
  (import "old" "inc" (func $f (param i32) (result i32)))
  (elem declare func $f)
  (func (export "ref") (result funcref) ref.func $f))
(assert_return (invoke "ref") (ref.func))
