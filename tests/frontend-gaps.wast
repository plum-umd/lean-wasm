;; Numeric type indices remain validation errors, even when inferred types are added later.
(assert_invalid (module (func (type 42))) "unknown type")
(assert_invalid (module (import "spectest" "print_i32" (func (type 43)))) "unknown type")
(assert_invalid (module (table 0 funcref)
  (func (call_indirect (type 1) (i32.const 0)))) "unknown type")
(assert_invalid (module (type (func)) (func (loop (type 99)))) "unknown type")
(module
  (func (export "flat") (param i32) (result i32)
    i32.const 11 i32.const 22 local.get 0 select (result) (result i32) (result)))
(assert_return (invoke "flat" (i32.const 1)) (i32.const 11))
(assert_return (invoke "flat" (i32.const 0)) (i32.const 22))
(module
  (func $f (result i32) (i32.const 42))
  (table 2 funcref (ref.func $f))
  (func (export "call") (param i32) (result i32)
    (call_indirect (result i32) (local.get 0))))
(assert_return (invoke "call" (i32.const 0)) (i32.const 42))
(assert_return (invoke "call" (i32.const 1)) (i32.const 42))
(module
  (global (import "spectest" "global_i32") i32)
  (table 10 funcref)
  (func $f (result i32) (i32.const 7))
  (elem (offset (i32.add (i32.sub (global.get 0) (i32.const 665)) (i32.const 2))) func $f)
  (func (export "call") (result i32) (call_indirect (result i32) (i32.const 3))))
(assert_return (invoke "call") (i32.const 7))
(module
  (table $t 1 externref (ref.null extern))
  (elem $e externref (ref.null extern))
  (func (export "init") (table.init $t $e (i32.const 0) (i32.const 0) (i32.const 1)))
  (func (export "get") (result externref) (table.get $t (i32.const 0))))
(assert_return (invoke "init"))
(assert_return (invoke "get") (ref.null extern))
(assert_invalid (module (table 1 funcref) (elem (ref.null func))) "offset type mismatch")
(assert_invalid (module (table 1 funcref (ref.null extern))) "initializer type mismatch")
(assert_invalid (module (global funcref (ref.null func))
  (table 1 funcref (global.get 0))) "defined globals unavailable during table initialization")
