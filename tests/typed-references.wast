;; Function subtyping, canonical identities, typed imports and reference control.
(module $Producer
  (type $Parent (sub (func (result i32))))
  (type $Child (sub final $Parent (func (result i32))))
  (func $f (export "f") (type $Child) i32.const 42)
  (elem declare func $f)
  (global (export "g") (ref $Parent) (ref.func $f))
  (table (export "t") 1 (ref $Parent) (ref.func $f))
  (func (export "via-table") (result i32) i32.const 0 call_indirect (type $Parent))
  (func (export "via-global") (result i32) global.get 0 call_ref $Parent))
(register "producer" $Producer)
(assert_return (invoke "via-table") (i32.const 42))
(assert_return (invoke "via-global") (i32.const 42))
(module
  (type $Parent (sub (func (result i32))))
  (import "producer" "f" (func $f (type $Parent)))
  (import "producer" "g" (global $g (ref $Parent)))
  (import "producer" "t" (table $t 1 (ref $Parent)))
  (func (export "direct") (result i32) call $f)
  (func (export "reference") (result i32) global.get $g call_ref $Parent)
  (func (export "indirect") (result i32) i32.const 0 call_indirect $t (type $Parent)))
(assert_return (invoke "direct") (i32.const 42))
(assert_return (invoke "reference") (i32.const 42))
(assert_return (invoke "indirect") (i32.const 42))
(module
  (type $F (func (result i32)))
  (func $f (type $F) i32.const 7)
  (elem declare func $f)
  (func (export "local") (result i32) (local $x (ref $F))
    ref.func $f local.set $x local.get $x call_ref $F)
  (func (export "null-call") (result i32) ref.null $F call_ref $F)
  (func (export "null-cast") ref.null $F ref.as_non_null drop)
  (func (export "cast") (result i32) ref.func $f ref.as_non_null call_ref $F)
  (func (export "null-branch") (result i32)
    block $done ref.null extern br_on_null $done drop unreachable end i32.const 1)
  (func (export "nonnull-branch") (param externref) (result externref)
    block $done (result externref)
      local.get 0 br_on_non_null $done ref.null extern
    end))
(assert_return (invoke "local") (i32.const 7))
(assert_trap (invoke "null-call") "null function reference")
(assert_trap (invoke "null-cast") "null reference")
(assert_return (invoke "cast") (i32.const 7))
(assert_return (invoke "null-branch") (i32.const 1))
(assert_return (invoke "nonnull-branch" (ref.extern 12)) (ref.extern 12))
(assert_return (invoke "nonnull-branch" (ref.null extern)) (ref.null extern))
(assert_invalid (module
  (type $F (func))
  (func (local $x (ref $F)) local.get $x drop)) "uninitialized local")
(assert_invalid (module
  (type $F (func))
  (func (local $x (ref $F)) ref.null $F local.set $x)) "type mismatch")
(assert_invalid (module
  (type $P (func)) (type (sub $P (func)))) "final supertype")
(assert_invalid (module
  (type $P (sub (func (result i32))))
  (type (sub $P (func (result i64))))) "invalid subtype")
(assert_invalid (module (func ref.null 1 drop)) "unknown heap type")
(assert_invalid (module (func call_ref 99)) "unknown type")
(module (rec
  (type $A (func (param (ref null $B))))
  (type $B (func (param (ref null $A))))))
(assert_invalid (module (table (ref func) (elem))) "nonnullable default initializer")

(module binary "\00\61\73\6d\01\00\00\00\01\12\03\50\00\60\00\01\7f\4f\01\00\60\00\01\7f\60\00\01\7f\03\06\05\01\02\02\02\02\07\32\05\01\66\00\00\04\63\61\6c\6c\00\01\04\6e\75\6c\6c\00\02\0b\6e\75\6c\6c\2d\62\72\61\6e\63\68\00\03\0e\6e\6f\6e\6e\75\6c\6c\2d\62\72\61\6e\63\68\00\04\0a\32\05\04\00\41\2a\0b\07\00\d2\00\d4\14\00\0b\06\00\d0\00\14\00\0b\0d\00\02\40\d0\70\d5\00\1a\00\0b\41\09\0b\0e\00\02\70\d2\00\d6\00\d0\70\0b\1a\41\09\0b")
(assert_return (invoke "call") (i32.const 42))
(assert_trap (invoke "null") "null function reference")
(assert_return (invoke "null-branch") (i32.const 9))
(assert_return (invoke "nonnull-branch") (i32.const 9))
(module binary "\00\61\73\6d\01\00\00\00\01\0d\01\4e\02\60\01\63\01\00\60\01\63\00\00")

(module
  (type $F (func))
  (func (export "null-roundtrip") (param (ref null $F)) (result (ref null $F)) local.get 0))
(assert_return (invoke "null-roundtrip" (ref.null 0)) (ref.null))
(assert_return (invoke "null-roundtrip" (ref.null nofunc)) (ref.null func))
(assert_return (invoke "null-roundtrip" (ref.null nofunc)) (ref.null))
