;; Integer memory operations, memory64, named segments, and shared imports.
(module $M
  (memory $small (export "memory") 1 2)
  (memory $wide i64 1 2)
  (global $offset i32 (i32.const 8))
  (data (offset (i32.add (global.get $offset) (i32.const 2))) "\ff\80\01\00")
  (data $passive "ABCD")
  (data (memory $wide) (i64.const 0) "\fe")
  (func (export "read") (param i32) (result i32) (i32.load8_u $small (local.get 0)))
  (func (export "signed") (result i32) (i32.load8_s offset=10 align=1 (i32.const 0)))
  (func (export "wide") (result i64) (i64.load8_s $wide (i64.const 0)))
  (func (export "size") (result i32) memory.size $small)
  (func (export "size64") (result i64) memory.size $wide)
  (func (export "grow") (param i32) (result i32) local.get 0 memory.grow $small)
  (func (export "grow64") (param i64) (result i64) local.get 0 memory.grow $wide)
  (func (export "init") (param i32 i32 i32)
    local.get 0 local.get 1 local.get 2 memory.init $small $passive)
  (func (export "drop") data.drop $passive)
  (func (export "fill") (param i32 i32 i32)
    local.get 0 local.get 1 local.get 2 memory.fill)
  (func (export "copy") (param i32 i32 i32)
    local.get 0 local.get 1 local.get 2 memory.copy)
  (func (export "cross") (param i64 i32 i32)
    local.get 0 local.get 1 local.get 2 memory.copy $wide $small)
  (func (export "wide-read") (param i64) (result i32) local.get 0 i32.load8_u $wide))
(assert_return (invoke "read" (i32.const 10)) (i32.const 255))
(assert_return (invoke "signed") (i32.const -1))
(assert_return (invoke "wide") (i64.const -2))
(assert_return (invoke "size") (i32.const 1))
(assert_return (invoke "size64") (i64.const 1))
(assert_return (invoke "init" (i32.const 20) (i32.const 1) (i32.const 3)))
(assert_return (invoke "read" (i32.const 20)) (i32.const 66))
(assert_return (invoke "fill" (i32.const 30) (i32.const 511) (i32.const 4)))
(assert_return (invoke "read" (i32.const 33)) (i32.const 255))
(assert_return (invoke "copy" (i32.const 31) (i32.const 20) (i32.const 3)))
(assert_return (invoke "read" (i32.const 32)) (i32.const 67))
(assert_return (invoke "cross" (i64.const 40) (i32.const 20) (i32.const 3)))
(assert_return (invoke "wide-read" (i64.const 42)) (i32.const 68))
(assert_trap (invoke "read" (i32.const 65536)) "out of bounds memory access")
(assert_trap (invoke "fill" (i32.const 65535) (i32.const 0) (i32.const 2)) "out of bounds")
(assert_return (invoke "fill" (i32.const 65536) (i32.const 0) (i32.const 0)))
(assert_trap (invoke "fill" (i32.const 65537) (i32.const 0) (i32.const 0)) "out of bounds")
(assert_return (invoke "drop"))
(assert_return (invoke "drop"))
(assert_return (invoke "init" (i32.const 0) (i32.const 0) (i32.const 0)))
(assert_trap (invoke "init" (i32.const 0) (i32.const 0) (i32.const 1)) "out of bounds")
(assert_return (invoke "grow" (i32.const 1)) (i32.const 1))
(assert_return (invoke "size") (i32.const 2))
(assert_return (invoke "read" (i32.const 65536)) (i32.const 0))
(assert_return (invoke "grow" (i32.const 1)) (i32.const -1))
(assert_return (invoke "grow64" (i64.const 1)) (i64.const 1))
(assert_return (invoke "grow64" (i64.const -1)) (i64.const -1))
(register "memories" $M)
(module $consumer
  (memory $shared (export "shared") (import "memories" "memory") 2 3)
  (func (export "write") (i32.store8 $shared (i32.const 0) (i32.const 99))))
(assert_return (invoke "write"))
(assert_return (invoke $M "read" (i32.const 0)) (i32.const 99))
(assert_unlinkable (module (import "memories" "memory" (memory 3))) "incompatible import type")
(assert_unlinkable (module (import "memories" "memory" (memory i64 1))) "incompatible import type")
(assert_trap (module (import "memories" "memory" (memory 2))
  (data (i32.const 0) "Z") (data (i32.const 131072) "x")) "out of bounds memory access")
(assert_return (invoke $M "read" (i32.const 0)) (i32.const 90))
(module (memory $inline (export "bytes") (data "\00" "\ff"))
  (data $later "q")
  (func (export "read") (result i32) (i32.load8_u $inline (i32.const 1)))
  (func (export "init") (i32.const 0) (i32.const 0) (i32.const 1) memory.init $later))
(assert_return (invoke "read") (i32.const 255))
(assert_return (invoke "init"))
;; Rejection belongs to validation, not text parsing.
(assert_invalid (module (memory 2 1)) "memory size must be at most maximum")
(assert_invalid (module (memory 65537)) "memory size must be at most 65536 pages")
(assert_invalid (module (memory i64 281474976710657)) "memory size too large")
(assert_invalid (module (func (result i32) memory.size)) "unknown memory")
(assert_invalid (module (memory 0) (func (result i32) memory.size 1)) "unknown memory")
(assert_invalid (module (memory 1) (func (i32.load8_u align=2 (i32.const 0)) drop)) "alignment")
(assert_invalid (module (memory 1) (func (i64.store32 align=8 (i32.const 0) (i64.const 0)))) "alignment")
(assert_invalid (module (memory 1) (func (i32.load offset=4294967296 (i32.const 0)) drop)) "offset")
(assert_invalid (module (memory 1) (func (i32.load (i64.const 0)) drop)) "address type")
(assert_invalid (module (memory i64 1) (func (i32.load (i32.const 0)) drop)) "address type")
(assert_invalid (module (memory 1) (func (i32.store (i32.const 0) (i64.const 0)))) "value type")
(assert_invalid (module (memory 1) (func i32.const 0 i32.const 0 i32.const 0 memory.init 0)) "unknown data")
(assert_invalid (module (func data.drop 0)) "unknown data")
(assert_invalid (module (data (i32.const 0) "x")) "unknown memory")
(assert_invalid (module (memory 1) (data (i64.const 0) "x")) "offset type")
(assert_invalid (module (memory 1) (global $g (mut i32) (i32.const 0))
  (data (global.get $g) "x")) "constant expression required")
(assert_invalid (module (memory 1) (data (i32.div_s (i32.const 0) (i32.const 1)) "x")) "constant expression")
(assert_trap (module (memory 0) (data (i32.const 0) "x")) "out of bounds")
(module (memory 0) (data (i32.const 0) ""))
(module (data "passive without memory"))
(module (memory 1)
  (func (export "roundtrip") (result i32)
    (i32.store offset=4 align=1 (i32.const 0) (i32.const -1))
    (i32.load offset=4 align=1 (i32.const 0))))
(assert_return (invoke "roundtrip") (i32.const -1))
(module (memory 1)
  (func (export "roundtrip") (result i32)
    (i32.store8 offset=4 align=1 (i32.const 0) (i32.const -1))
    (i32.load8_s offset=4 align=1 (i32.const 0))))
(assert_return (invoke "roundtrip") (i32.const -1))
(module (memory 1)
  (func (export "roundtrip") (result i32)
    (i32.store8 offset=4 align=1 (i32.const 0) (i32.const -1))
    (i32.load8_u offset=4 align=1 (i32.const 0))))
(assert_return (invoke "roundtrip") (i32.const 255))
(module (memory 1)
  (func (export "roundtrip") (result i32)
    (i32.store16 offset=4 align=1 (i32.const 0) (i32.const -1))
    (i32.load16_s offset=4 align=1 (i32.const 0))))
(assert_return (invoke "roundtrip") (i32.const -1))
(module (memory 1)
  (func (export "roundtrip") (result i32)
    (i32.store16 offset=4 align=1 (i32.const 0) (i32.const -1))
    (i32.load16_u offset=4 align=1 (i32.const 0))))
(assert_return (invoke "roundtrip") (i32.const 65535))
(module (memory 1)
  (func (export "roundtrip") (result i64)
    (i64.store offset=4 align=1 (i32.const 0) (i64.const -1))
    (i64.load offset=4 align=1 (i32.const 0))))
(assert_return (invoke "roundtrip") (i64.const -1))
(module (memory 1)
  (func (export "roundtrip") (result i64)
    (i64.store8 offset=4 align=1 (i32.const 0) (i64.const -1))
    (i64.load8_s offset=4 align=1 (i32.const 0))))
(assert_return (invoke "roundtrip") (i64.const -1))
(module (memory 1)
  (func (export "roundtrip") (result i64)
    (i64.store8 offset=4 align=1 (i32.const 0) (i64.const -1))
    (i64.load8_u offset=4 align=1 (i32.const 0))))
(assert_return (invoke "roundtrip") (i64.const 255))
(module (memory 1)
  (func (export "roundtrip") (result i64)
    (i64.store16 offset=4 align=1 (i32.const 0) (i64.const -1))
    (i64.load16_s offset=4 align=1 (i32.const 0))))
(assert_return (invoke "roundtrip") (i64.const -1))
(module (memory 1)
  (func (export "roundtrip") (result i64)
    (i64.store16 offset=4 align=1 (i32.const 0) (i64.const -1))
    (i64.load16_u offset=4 align=1 (i32.const 0))))
(assert_return (invoke "roundtrip") (i64.const 65535))
(module (memory 1)
  (func (export "roundtrip") (result i64)
    (i64.store32 offset=4 align=1 (i32.const 0) (i64.const -1))
    (i64.load32_s offset=4 align=1 (i32.const 0))))
(assert_return (invoke "roundtrip") (i64.const -1))
(module (memory 1)
  (func (export "roundtrip") (result i64)
    (i64.store32 offset=4 align=1 (i32.const 0) (i64.const -1))
    (i64.load32_u offset=4 align=1 (i32.const 0))))
(assert_return (invoke "roundtrip") (i64.const 4294967295))
