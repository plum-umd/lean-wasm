(module
  (type $empty (struct))
  (type $packed (array (mut i8)))
  (global $number (ref i31) (ref.i31 (i32.const -1)))
  (global $external (ref extern) (extern.convert_any (global.get $number)))
  (global $internal (ref any) (any.convert_extern (global.get $external)))
  (func (export "signed") (param i32) (result i32)
    local.get 0 ref.i31 i31.get_s)
  (func (export "unsigned") (param i32) (result i32)
    local.get 0 ref.i31 i31.get_u)
  (func (export "equal") (param i32 i32) (result i32)
    local.get 0 ref.i31 local.get 1 ref.i31 ref.eq)
  (func (export "null") (result i32)
    ref.null i31 i31.get_s)
  (func (export "null-equality") (result i32)
    ref.null struct ref.null array ref.eq)
  (func (export "null-conversion") (result i32)
    ref.null extern any.convert_extern extern.convert_any ref.is_null)
  (func (export "cast-number") (result i32)
    global.get $internal ref.cast (ref i31) i31.get_s)
  (func (export "test-number") (result i32)
    global.get $internal ref.test (ref i31))
  (func (export "test-null") (result i32 i32)
    ref.null any ref.test (ref null i31)
    ref.null any ref.test (ref i31))
  (func (export "test-struct-null") (result i32)
    ref.null any ref.test (ref null $empty))
  (func (export "cast-null") (result (ref null i31))
    ref.null any ref.cast (ref null i31))
  (func (export "cast-null-trap") (result (ref i31))
    ref.null any ref.cast (ref i31))
  (func (export "cast-failure") (result (ref struct))
    global.get $internal ref.cast (ref struct))
  (func (export "nonnull-conversion") (param (ref extern)) (result (ref any))
    local.get 0 any.convert_extern)
)
(assert_return (invoke "signed"  (i32.const -1)) (i32.const -1))
(assert_return (invoke "unsigned" (i32.const -1)) (i32.const 2147483647))
(assert_return (invoke "signed" (i32.const 2147483648)) (i32.const 0))
(assert_return (invoke "signed" (i32.const 1073741824)) (i32.const -1073741824))
(assert_return (invoke "unsigned" (i32.const 1073741824)) (i32.const 1073741824))
(assert_return (invoke "equal" (i32.const 0) (i32.const 2147483648)) (i32.const 1))
(assert_return (invoke "equal" (i32.const 0) (i32.const 1)) (i32.const 0))
(assert_trap (invoke "null") "null i31 reference")
(assert_return (invoke "null-equality") (i32.const 1))
(assert_return (invoke "null-conversion") (i32.const 1))
(assert_invalid (module (type $s (struct)) (func (type $s))) "type mismatch")
(assert_invalid (module (func (param externref) (result (ref any))
  local.get 0 any.convert_extern)) "type mismatch")
(assert_invalid (module (func (param anyref) (result (ref extern))
  local.get 0 extern.convert_any)) "type mismatch")
(assert_invalid (module (func (param externref externref) (result i32)
  local.get 0 local.get 1 ref.eq)) "type mismatch")

(assert_return (invoke "cast-number") (i32.const -1))
(assert_return (invoke "test-number") (i32.const 1))
(assert_return (invoke "test-null") (i32.const 1) (i32.const 0))
(assert_return (invoke "test-struct-null") (i32.const 1))
(assert_return (invoke "cast-null") (ref.null))
(assert_trap (invoke "cast-null-trap") "cast failure")
(assert_trap (invoke "cast-failure") "cast failure")
(assert_invalid (module (func (param externref) (result i32)
  local.get 0 ref.test (ref i31))) "type mismatch")
