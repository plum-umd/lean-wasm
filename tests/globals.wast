(module $provider
  (global $a (export "a") i32 (i32.const 7))
  (global $b (export "b") i64 (i64.const -2))
  (global $x (export "x") (mut i32) (i32.const 10))
  (global $y (export "y") (mut i64) (i64.const 20))
  (global $r (export "r") (mut externref) (ref.null extern))
  (global $f (export "f") (mut funcref) (ref.func $target))
  (global $sum (export "sum") i32
    (i32.add (i32.mul (global.get $a) (i32.const 6)) (i32.const 1)))
  (global $wide (export "wide") i64
    i64.const -1 i64.const 3 i64.sub i64.const 2 i64.mul)
  (func $target (param i32) (result i32) local.get 0 i32.const 1 i32.add)
  (func (export "set-x") (param i32) local.get 0 global.set $x)
  (func (export "get-x") (result i32) (global.get $x))
  (func (export "set-y") (param i64) (global.set $y (local.get 0)))
  (func (export "set-r") (param externref) local.get 0 global.set $r)
  (table $t 1 funcref)
  (func (export "call") (param i32) (result i32)
    i32.const 0 global.get $f table.set $t
    local.get 0 i32.const 0 call_indirect $t (param i32) (result i32))
  (func (export "clear-f") ref.null func global.set $f))
(register "P")
(assert_return (get "a") (i32.const 7))
(assert_return (get "b") (i64.const -2))
(assert_return (get "x") (i32.const 10))
(assert_return (get "y") (i64.const 20))
(assert_return (get "sum") (i32.const 43))
(assert_return (get "wide") (i64.const -8))
(assert_return (get "r") (ref.null extern))
(assert_return (get "f") (ref.func))
(assert_return (invoke "call" (i32.const 41)) (i32.const 42))
(assert_return (invoke "set-x" (i32.const 11)))
(assert_return (invoke "get-x") (i32.const 11))
(assert_return (invoke "set-y" (i64.const -1)))
(assert_return (get "y") (i64.const -1))
(assert_return (invoke "set-r" (ref.extern 9)))
(assert_return (get "r") (ref.extern 9))
(assert_return (invoke "clear-f"))
(assert_return (get "f") (ref.null func))
(assert_trap (invoke "call" (i32.const 0)) "uninitialized element")

(module $consumer
  (import "P" "a" (global $a i32))
  (global $x (export "x") (export "alias") (import "P" "x") (mut i32))
  (global $r (export "r") (import "P" "r") (mut externref))
  (global $copy (export "copy") i32 (global.get $a))
  (global $next (export "next") i32
    (i32.sub (global.get $copy) (i32.const 2)))
  (global $own (export "own") (mut i32) (i32.const 99))
  (func $start i32.const 12 global.set $x)
  (start $start)
  (func (export "set") (param i32) local.get 0 global.set $x)
  (func (export "set-r") (param externref) local.get 0 global.set $r))
(register "C" $consumer)
(assert_return (get "copy") (i32.const 7))
(assert_return (get "next") (i32.const 5))
(assert_return (get "own") (i32.const 99))
(assert_return (get $provider "x") (i32.const 12))
(assert_return (get "x") (i32.const 12))
(assert_return (get "alias") (i32.const 12))
(assert_return (invoke "set" (i32.const 42)))
(assert_return (get $provider "x") (i32.const 42))
(assert_return (invoke $provider "set-x" (i32.const 43)))
(assert_return (get "alias") (i32.const 43))
(assert_return (invoke "set-r" (ref.extern 77)))
(assert_return (get $provider "r") (ref.extern 77))
(get "r")
(module
  (global $r (export "r") (import "C" "r") (mut externref))
  (global $x (import "C" "x") (mut i32))
  (func (export "set") (param i32) local.get 0 global.set $x))
(assert_return (get "r") (ref.extern 77))
(assert_return (invoke "set" (i32.const 44)))
(assert_return (get $provider "x") (i32.const 44))
(assert_return (get $consumer "x") (i32.const 44))

(assert_unlinkable (module (import "P" "x" (global i32))) "mutability mismatch")
(assert_unlinkable (module (import "P" "a" (global (mut i32)))) "mutability mismatch")
(assert_unlinkable (module (import "P" "a" (global i64))) "type mismatch")
(assert_unlinkable (module (import "P" "r" (global (mut funcref)))) "type mismatch")
(assert_unlinkable (module (import "P" "set-x" (global i32))) "external kind mismatch")
(assert_unlinkable (module (import "P" "absent" (global i32))) "missing export")

(assert_invalid (module (global i32 (i64.const 0))) "type mismatch")
(assert_invalid (module (global i32)) "missing initializer")
(assert_invalid (module (global i32 i32.const 0 i32.const 1)) "extra initializer result")
(assert_invalid (module (global i32 (nop) (i32.const 0))) "nonconstant initializer")
(assert_invalid (module (global i32 (i32.div_u (i32.const 1) (i32.const 1))))
  "nonconstant initializer")
(assert_invalid (module (global i32 (call 0)) (func (result i32) i32.const 0))
  "nonconstant initializer")
(assert_invalid (module (global $g i32 (global.get $g))) "unknown global")
(assert_invalid (module (global $g i32 (global.get $later)) (global $later i32 (i32.const 0)))
  "unknown global")
(assert_invalid (module (global $a (mut i32) (i32.const 0)) (global i32 (global.get $a)))
  "mutable initializer read")
(assert_invalid (module (import "missing" "a" (global $a (mut i32)))
  (global i32 (global.get $a))) "mutable imported initializer read")
(assert_invalid (module (global funcref (ref.null extern))) "reference type mismatch")
(assert_invalid (module (global funcref (ref.func 1)) (func)) "unknown function reference")
(assert_invalid (module (global $a i32 (i32.const 0)) (func i32.const 1 global.set $a))
  "immutable global")
(assert_invalid (module (global $a i32 (i32.const 0)) (func unreachable global.set $a))
  "immutable global in dead code")
(assert_invalid (module (global (mut i32) (i32.const 0)) (func i64.const 0 global.set 0))
  "type mismatch")
(assert_invalid (module (global i64 (i64.const 0)) (func (result i32) global.get 0))
  "type mismatch")
(assert_invalid (module (func global.get 0 drop)) "unknown global")
(assert_invalid (module (func unreachable global.set 0)) "unknown global")
(assert_invalid (module (global i32 (i32.const 0)) (export "bad" (global 1)))
  "unknown global export")
(module (global (mut i32) (i32.const 0)) (func unreachable global.set 0))
